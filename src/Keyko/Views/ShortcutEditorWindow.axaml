<Window x:Class="Keyko.Views.ShortcutEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Keyko.ViewModels"
        x:DataType="vm:ShortcutEditorViewModel"
        x:CompileBindings="True"
        Title="Edit shortcut"
        Width="790" Height="720" MinWidth="740" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ShowInTaskbar="False"
        CanResize="False">

  <Border CornerRadius="18" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
          BoxShadow="0 24 70 -18 #88000000" ClipToBounds="True">
    <Panel>
      <Border x:Name="BaseWallpaper" Background="{StaticResource BaseGradient}" IsVisible="False" />
      <ExperimentalAcrylicBorder x:Name="Acrylic" CornerRadius="18" IsHitTestVisible="False">
        <ExperimentalAcrylicBorder.Material>
          <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                       TintColor="#17121D"
                                       TintOpacity="0.72"
                                       MaterialOpacity="0.55" />
        </ExperimentalAcrylicBorder.Material>
      </ExperimentalAcrylicBorder>

      <Grid RowDefinitions="54,*,64">

        <!-- ============ header ============ -->
        <Panel Grid.Row="0" Margin="16,0,10,0">
          <Border x:Name="DragZone" Background="Transparent" />
          <StackPanel Orientation="Horizontal" Spacing="12" IsHitTestVisible="False" VerticalAlignment="Center">
            <Image Source="avares://Keyko/Assets/logo.png" Width="36" Height="36" VerticalAlignment="Center" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock x:Name="TitleText" Text="New shortcut" Classes="h2" />
              <TextBlock Text="your cozy little launcher — it works everywhere, even from the tray" Classes="ter" FontSize="10.5" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="CloseBtn" Classes="icon ghost" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Classes="glyph" Text="&#xE711;" />
          </Button>
        </Panel>

        <!-- ============ content ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,2,10,0">
          <StackPanel Spacing="12">

            <!-- action card -->
            <Border Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Text="What should it do?" Classes="h2" />
                <WrapPanel>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeApplication}"
                          Click="OnTypeClick" Tag="Application" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE71D;" VerticalAlignment="Center" />
                      <TextBlock Text="Application" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeFolder}"
                          Click="OnTypeClick" Tag="Folder" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE8B7;" VerticalAlignment="Center" />
                      <TextBlock Text="Folder" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeUrl}"
                          Click="OnTypeClick" Tag="Url" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE774;" VerticalAlignment="Center" />
                      <TextBlock Text="Website" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeCommand}"
                          Click="OnTypeClick" Tag="Command" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE756;" VerticalAlignment="Center" />
                      <TextBlock Text="Command" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeSnippet}"
                          Click="OnTypeClick" Tag="Snippet" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE77B;" VerticalAlignment="Center" />
                      <TextBlock Text="Text snippet" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeKeySequence}"
                          Click="OnTypeClick" Tag="KeySequence" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE765;" VerticalAlignment="Center" />
                      <TextBlock Text="Key sequence" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeWebhook}"
                          Click="OnTypeClick" Tag="Webhook" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE8EA;" VerticalAlignment="Center" />
                      <TextBlock Text="Webhook" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeScript}"
                          Click="OnTypeClick" Tag="Script" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE943;" VerticalAlignment="Center" />
                      <TextBlock Text="Script" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeExpansion}"
                          Click="OnTypeClick" Tag="Expansion" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE77B;" VerticalAlignment="Center" />
                      <TextBlock Text="Text expansion" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="seg" Classes.selected="{Binding IsTypeSystem}"
                          Click="OnTypeClick" Tag="System" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="glyph g12" Text="&#xE945;" VerticalAlignment="Center" />
                      <TextBlock Text="System action" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </WrapPanel>

                <!-- application -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeApplication}">
                  <Grid ColumnDefinitions="*,Auto" >
                    <TextBox Watermark="C:\path\to\program.exe" Text="{Binding TargetText}"
                             TextWrapping="NoWrap" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Click="OnBrowseFile">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Classes="glyph g12" Text="&#xED25;" VerticalAlignment="Center" />
                        <TextBlock Text="Browse…" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBox Watermark="Arguments (optional)" Text="{Binding Arguments}" />
                  <TextBox Watermark="Working directory (optional)" Text="{Binding WorkingDirectory}" />
                </StackPanel>

                <!-- folder -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeFolder}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Watermark="C:\Users\me\Projects" Text="{Binding TargetText}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Click="OnBrowseFolder">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Classes="glyph g12" Text="&#xED25;" VerticalAlignment="Center" />
                        <TextBlock Text="Browse…" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>

                <!-- url -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeUrl}">
                  <TextBox Watermark="https://example.com" Text="{Binding TargetText}" />
                </StackPanel>

                <!-- command -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeCommand}">
                  <TextBox Watermark="git -C C:\repo pull" Text="{Binding TargetText}" />
                  <TextBlock Classes="ter" FontSize="11"
                             Text="Runs hidden via cmd /c. Use it for scripts, CLI tools, batch jobs…" />
                </StackPanel>

                <!-- snippet -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeSnippet}">
                  <TextBox Watermark="Paste this text at the cursor…" Text="{Binding SnippetText}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="92" />
                  <TextBlock Classes="ter" FontSize="11"
                             Text="Copies the text to the clipboard and presses Ctrl+V — types anywhere, in any app." />
                </StackPanel>

                <!-- key sequence -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeKeySequence}">
                  <TextBox Watermark="Hello!{Enter}" Text="{Binding SequenceText}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="92" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="chip" Click="OnInsertSeqToken" Content="{}{Tab}" />
                    <Button Classes="chip" Click="OnInsertSeqToken" Content="{}{Enter}" />
                    <Button Classes="chip" Click="OnInsertSeqToken" Content="{}{Ctrl+C}" />
                    <Button Classes="chip" Click="OnInsertSeqToken" Content="{}{Win+D}" />
                    <Button Classes="chip" Click="OnInsertSeqToken" Content="{}{Delay 250}" />
                  </StackPanel>
                  <TextBlock Classes="ter" FontSize="11" Text="{Binding SequenceHint}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- webhook -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeWebhook}">
                  <TextBox Watermark="https://hooks.example.com/abc123" Text="{Binding TargetText}" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox ItemsSource="{Binding HttpMethodChoices}" SelectedItem="{Binding HttpMethod}" Width="130" />
                    <TextBlock Classes="ter" FontSize="11.5" VerticalAlignment="Center"
                               Text="Fires the request; the body is skipped for GET." />
                  </StackPanel>
                  <TextBox Watermark="Request body (JSON, form data…)" Text="{Binding WebhookBody}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                </StackPanel>

                <!-- script -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeScript}">
                  <TextBox Watermark="Get-Process | Select-Object -First 3" Text="{Binding ScriptText}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="92" FontFamily="Consolas, Cascadia Mono" />
                  <TextBlock Classes="ter" FontSize="11"
                             Text="Runs hidden via Windows PowerShell. Errors surface as a toast." />
                </StackPanel>

                <!-- expansion -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeExpansion}">
                  <Grid ColumnDefinitions="220,*">
                    <TextBox Watermark=";addr" Text="{Binding Abbreviation}" />
                    <TextBlock Grid.Column="1" Classes="ter" FontSize="11.5" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="The abbreviation you type — expansions fire as you type, in any app." />
                  </Grid>
                  <TextBox Watermark="The full replacement text…" Text="{Binding TargetText}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="92" />
                  <TextBlock Classes="ter" FontSize="11"
                             Text="Type the abbreviation anywhere and Keyko eats it and sends the replacement. Word-boundary aware; respects pause and app exclusions." />
                </StackPanel>

                <!-- system -->
                <StackPanel Spacing="10" IsVisible="{Binding IsTypeSystem}">
                  <ComboBox ItemsSource="{Binding SystemActions}" SelectedIndex="{Binding SystemActionIndex}"
                            HorizontalAlignment="Stretch" MaxDropDownHeight="340">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShortcutEditorViewModel+SystemActionOption">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Classes="glyph" Text="{Binding Glyph}" Foreground="{StaticResource Accent1}" />
                          <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="ter" FontSize="11" Text="{Binding SystemActionHint}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- trigger card -->
            <Border Classes="card">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Trigger" Classes="h2" />
                  <Button Grid.Column="1" Classes="ghost" Click="OnClearHotkey" FontSize="11.5">
                    <TextBlock Text="Clear" />
                  </Button>
                </Grid>
                <Border x:Name="Recorder" Classes="row card" Focusable="True" MinHeight="52" Padding="14"
                        Background="{StaticResource InputBg}">
                  <Panel>
                    <TextBlock Text="Click here, then press the key combination…"
                               Classes="ter" FontSize="12.5"
                               IsVisible="{Binding !HasHotkeyDisplay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasHotkeyDisplay}"
                                VerticalAlignment="Center">
                      <TextBlock Classes="glyph" Text="&#xE765;" Foreground="{StaticResource Accent2}" />
                      <TextBlock Text="{Binding HotkeyDisplay}" FontSize="16" FontWeight="Normal" />
                    </StackPanel>
                  </Panel>
                </Border>
                <Border Classes="banner" IsVisible="{Binding HasHotkeyWarning}" Background="{StaticResource DangerBg}"
                        BorderBrush="{StaticResource Danger}" Padding="10,8">
                  <TextBlock Text="{Binding HotkeyWarning}" FontSize="12" Foreground="{StaticResource Danger}" />
                </Border>
                <TextBlock Classes="ter" FontSize="11"
                           Text="Press Esc while recording to clear. Combos with Win, Alt, Ctrl, Shift all work — but combos the shell already owns (Win+T = taskbar, Win+G = Game Bar…) never reach Keyko, so pick something else for those." />
              </StackPanel>
            </Border>

            <!-- details card -->
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Details" Classes="h2" />
                <TextBox x:Name="NameBox" Watermark="Name" Text="{Binding Name}" FontSize="14" />
                <TextBox Watermark="Description (optional)" Text="{Binding Description}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Watermark="Category (e.g. Work, Web, Media)" Text="{Binding Category}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <CheckBox IsChecked="{Binding Enabled}" Content="Enabled" />
                  <CheckBox IsChecked="{Binding ShowToast}" Content="Toast on launch" />
                </StackPanel>

                <!-- schedule -->
                <StackPanel Spacing="8">
                  <TextBlock Text="Run on a schedule (no hotkey needed)" Classes="sec" FontSize="12" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox SelectedIndex="{Binding ScheduleIndex}" Width="180">
                      <ComboBoxItem Content="No schedule" />
                      <ComboBoxItem Content="Every N minutes" />
                      <ComboBoxItem Content="Daily at time" />
                    </ComboBox>
                    <TextBox Width="90" Watermark="30" Text="{Binding ScheduleIntervalMinutes}"
                             IsVisible="{Binding ScheduleIndex, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBox Width="110" Watermark="09:00" Text="{Binding ScheduleDailyTime}"
                             IsVisible="{Binding ScheduleIndex, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </StackPanel>

                <!-- app scoping -->
                <StackPanel Spacing="8">
                  <TextBlock Text="Only in these apps (semicolon-separated, no .exe)" Classes="sec" FontSize="12" />
                  <TextBox Watermark="empty = everywhere" Text="{Binding OnlyInApps}" />
                  <TextBlock Text="Never in these apps" Classes="sec" FontSize="12" />
                  <TextBox Watermark="empty = no exclusions" Text="{Binding NotInApps}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ footer ============ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="16,10,14,12">
          <Button x:Name="TestRunBtn" Classes="ghost" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="glyph g12" Text="&#xE768;" VerticalAlignment="Center" />
              <TextBlock Text="Test run" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" x:Name="CancelBtn" Width="96" Margin="0,0,8,0">
            <TextBlock Text="Cancel" />
          </Button>
          <Button Grid.Column="2" x:Name="SaveBtn" Classes="primary" Width="130">
            <TextBlock Text="Save shortcut" />
          </Button>
        </Grid>
      </Grid>
    </Panel>
  </Border>
</Window>
