<UserControl x:Class="Keyko.Views.Pages.SettingsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Keyko.ViewModels"
             xmlns:controls="clr-namespace:Keyko.Views"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <StackPanel Spacing="14" Margin="2,0,0,14" MaxWidth="860" HorizontalAlignment="Left">

      <TextBlock Text="Settings" Classes="h1" Margin="2,0,0,2" />

      <!-- appearance -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Text="Appearance" Classes="h2" />

          <StackPanel Spacing="8">
            <TextBlock Text="Theme" Classes="sec" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="seg" Classes.selected="{Binding IsDarkTheme}"
                      Command="{Binding SetThemeCommand}" CommandParameter="Dark" MinWidth="110">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="glyph g12" Text="&#xE708;" VerticalAlignment="Center" />
                  <TextBlock Text="Dark" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="seg" Classes.selected="{Binding IsLightTheme}"
                      Command="{Binding SetThemeCommand}" CommandParameter="Light" MinWidth="110">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="glyph g12" Text="&#xE706;" VerticalAlignment="Center" />
                  <TextBlock Text="Light" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Accent" Classes="sec" FontSize="12" />
            <ItemsControl ItemsSource="{Binding AccentPresets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AccentPresetViewModel">
                  <Button Classes="icon swatch" Classes.sel="{Binding IsSelected}"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetAccentCommand}"
                          CommandParameter="{Binding Name}"
                          ToolTip.Tip="{Binding Name}">
                    <Border Width="26" Height="26" CornerRadius="9" Background="{Binding Swatch}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Glass tint" Classes="sec" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="{Binding GlassOpacity, StringFormat={}{0:0%}}" Classes="ter" FontSize="11.5"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Slider Minimum="0.30" Maximum="0.95" Value="{Binding GlassOpacity}" TickFrequency="0.05"
                    Width="340" HorizontalAlignment="Left" />
            <TextBlock Text="Lower = more transparent, more desktop blur shows through." Classes="ter" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- behavior -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="Behavior" Classes="h2" />
          <ToggleSwitch IsChecked="{Binding LaunchOnStartup}" Content="Launch at Windows startup (starts minimized)" />
          <ToggleSwitch IsChecked="{Binding RunAsAdmin}"
                        Content="Run with administrator rights (asks once, then relaunches elevated)" />
          <TextBlock Text="{Binding ElevationStatus}" Classes="ter" FontSize="11" Margin="0,-8,0,0" TextWrapping="Wrap" />
          <ToggleSwitch IsChecked="{Binding StartMinimized}" Content="Start minimized to the tray" />
          <ToggleSwitch IsChecked="{Binding ShowToasts}" Content="Show a toast when a hotkey fires" />
          <ToggleSwitch IsChecked="{Binding SoundOnLaunch}" Content="Play a soft chime when a hotkey fires" />
          <ToggleSwitch IsChecked="{Binding FollowSystemTheme}" Content="Follow the Windows dark/light setting" />
        </StackPanel>
      </Border>

      <!-- system hotkeys -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="System hotkeys" Classes="h2" />
          <TextBlock Classes="ter" FontSize="11"
                     Text="Reserved combos for Keyko itself. Esc while recording clears a combo; leave empty to disable." />
          <Grid ColumnDefinitions="180,Auto" Margin="0,0,0,8">
            <TextBlock Text="Search overlay" VerticalAlignment="Center" />
            <controls:HotkeyRecorderBox Grid.Column="1" Width="220" HorizontalAlignment="Left" x:Name="SearchRecorder" />
          </Grid>
          <Grid ColumnDefinitions="180,Auto" Margin="0,0,0,8">
            <TextBlock Text="Pause / resume Keyko" VerticalAlignment="Center" />
            <controls:HotkeyRecorderBox Grid.Column="1" Width="220" HorizontalAlignment="Left" x:Name="PauseRecorder" />
          </Grid>
          <Grid ColumnDefinitions="180,Auto" Margin="0,0,0,8">
            <TextBlock Text="Cycle profile" VerticalAlignment="Center" />
            <controls:HotkeyRecorderBox Grid.Column="1" Width="220" HorizontalAlignment="Left" x:Name="ProfileRecorder" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- profiles -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Profiles" Classes="h2" />
          <TextBlock Classes="ter" FontSize="11"
                     Text="Each profile keeps its own set of shortcuts. Switching swaps the armed hotkeys instantly." />
          <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Classes="row" Margin="0,0,0,8" Padding="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Content="Switch"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SwitchProfileCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Watermark="New profile name…" Text="{Binding NewProfileName}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding CreateProfileCommand}">
              <TextBlock Text="Create" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- exclusions -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="App exclusions" Classes="h2" />
          <TextBlock Classes="ter" FontSize="11"
                     Text="Keyko sleeps in these apps. Semicolon-separated exe names without .exe — e.g. cs2; valorant; ExampleApp." />
          <TextBox Watermark="cs2; valorant" Text="{Binding GlobalExclusions}" AcceptsReturn="False" />
        </StackPanel>
      </Border>

      <!-- data -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Data" Classes="h2" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding OpenConfigFolderCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="glyph g12" Text="&#xE8B7;" VerticalAlignment="Center" />
                <TextBlock Text="Open config folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding ConfigPath}" Classes="ter" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="ter" FontSize="11"
                     Text="Shortcuts, theme and stats live in a single JSON file. Export/Import buttons on the Shortcuts page copy it anywhere." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
