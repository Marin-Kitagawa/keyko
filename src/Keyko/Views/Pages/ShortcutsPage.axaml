<UserControl x:Class="Keyko.Views.Pages.ShortcutsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Keyko.ViewModels"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- ============ header ============ -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="2,0,0,14">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Shortcuts" Classes="h1" />
        <Border Classes="kbd" Margin="0,2,0,0">
          <TextBlock Text="{Binding FilteredItems.Count, StringFormat='{}{0} shown'}" />
        </Border>
      </StackPanel>

      <!-- search -->
      <Panel Grid.Column="2" Width="280" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Watermark="Search shortcuts, hotkeys, targets…"
                 Text="{Binding SearchText}" Padding="34,7" />
        <TextBlock Classes="glyph" Text="&#xE721;" Margin="12,0,0,0" VerticalAlignment="Center"
                   HorizontalAlignment="Left" Foreground="{StaticResource TextTertiary}" />
      </Panel>

      <Button Grid.Column="3" Classes="icon ghost" Margin="8,0,0,0" Command="{Binding ImportCommand}"
              ToolTip.Tip="Import profile (JSON)">
        <TextBlock Classes="glyph" Text="&#xE896;" />
      </Button>
      <Button Grid.Column="4" Classes="icon ghost" Margin="4,0,0,0" Command="{Binding ExportCommand}"
              ToolTip.Tip="Export profile (JSON)">
        <TextBlock Classes="glyph" Text="&#xE898;" />
      </Button>

      <Button Grid.Column="5" Classes="primary" Margin="10,0,0,0" Command="{Binding NewShortcutCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="glyph" Text="&#xE710;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="New Shortcut" FontFamily="avares://Keyko/Assets/Fonts/LavishlyYours-Regular.ttf#Lavishly Yours" FontSize="18" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- ============ conflict banner ============ -->
    <Border Grid.Row="1" Classes="banner" IsVisible="{Binding HasConflicts}" Margin="2,0,0,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="glyph" Text="&#xE7BA;" Foreground="{StaticResource Warning}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ConflictText}" FontSize="12.5" VerticalAlignment="Center"
                     Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Classes="icon ghost" Grid.Column="2" Command="{Binding ClearConflictCommand}" VerticalAlignment="Top">
          <TextBlock Classes="glyph g12" Text="&#xE711;" />
        </Button>
      </Grid>
    </Border>

    <!-- ============ category chips ============ -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                  MaxHeight="46" Margin="2,0,0,10">
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryChipViewModel">
            <Button Classes="chip" Classes.active="{Binding IsSelected}"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectCategoryCommand}"
                    CommandParameter="{Binding}" Margin="0,0,8,0">
              <TextBlock Text="{Binding Display}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="0" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>

    <!-- ============ list ============ -->
    <Panel Grid.Row="3">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <ItemsControl ItemsSource="{Binding FilteredItems}" Margin="2,0,0,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShortcutItemViewModel">
              <Border Classes="card row" Margin="0,0,0,12" MinHeight="74"
                      DoubleTapped="OnRowDoubleTapped">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                  <!-- icon tile -->
                  <Border Width="46" Height="46" CornerRadius="12" Background="{Binding TileBrush}"
                          VerticalAlignment="Center" BoxShadow="0 4 12 -4 #66000000" ClipToBounds="True">
                    <Panel>
                      <Image Source="{Binding IconImage}" IsVisible="{Binding HasIcon}"
                             Width="28" Height="28" Stretch="Uniform" />
                      <TextBlock Text="{Binding TileGlyph}" FontSize="19" IsVisible="{Binding TileIsEmoji}"
                                 FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Classes="glyph" Text="{Binding TileFluentGlyph}" FontSize="17"
                                 Foreground="White" IsVisible="{Binding TileUseFluentGlyph}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Border>

                  <!-- name + description -->
                  <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="15"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Description}" Classes="ter" FontSize="11.5"
                                 TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />
                      <Border CornerRadius="999" Padding="8,2" Background="{Binding CategoryBrush}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Normal"
                                   Foreground="{Binding CategoryFgBrush}" />
                      </Border>
                    </StackPanel>
                  </StackPanel>

                  <!-- hover actions -->
                  <StackPanel Grid.Column="2" Classes="rowActions" Orientation="Horizontal" Spacing="2"
                              Width="146" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="icon ghost" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunNowCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Run now">
                      <TextBlock Classes="glyph" Text="&#xE768;" />
                    </Button>
                    <Button Classes="icon ghost" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Edit">
                      <TextBlock Classes="glyph" Text="&#xE70F;" />
                    </Button>
                    <Button Classes="icon ghost" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DuplicateCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Duplicate">
                      <TextBlock Classes="glyph" Text="&#xE8C8;" />
                    </Button>
                    <Button Classes="icon ghost danger" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Delete">
                      <TextBlock Classes="glyph" Text="&#xE74D;" />
                    </Button>
                  </StackPanel>

                  <!-- hotkey + toggle -->
                  <StackPanel Grid.Column="3" Orientation="Vertical" Spacing="5" VerticalAlignment="Center"
                              Margin="6,0,2,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Classes="kbd" ToolTip.Tip="{Binding LastUsedText}">
                        <TextBlock Text="{Binding HotkeyDisplay}" />
                      </Border>
                      <ToggleSwitch IsChecked="{Binding IsEnabled}" Padding="0" MinWidth="0"
                                    OffContent="" OnContent="" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding RunCountText}" Classes="ter" FontSize="10"
                               HorizontalAlignment="Right" Margin="0,0,4,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- empty state -->
      <StackPanel IsVisible="{Binding !HasVisibleItems}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="10" Opacity="0.85">
        <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource ChipBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" HorizontalAlignment="Center">
          <TextBlock Classes="glyph g20" Text="&#xE765;" FontSize="26" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}" />
        </Border>
        <TextBlock Text="No shortcuts here yet ♡" FontFamily="avares://Keyko/Assets/Fonts/LavishlyYours-Regular.ttf#Lavishly Yours" FontSize="26" HorizontalAlignment="Center" />
        <TextBlock Text="Press New Shortcut to make one — or clear the filters ♡" Classes="ter"
                   FontSize="12" HorizontalAlignment="Center" />
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
